<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================================
         1. CUSTOMER & CORPORATE INVOICES (club.invoice)
         ========================================================================= -->

    <!-- Invoice Tree View -->
    <record id="view_club_invoice_tree" model="ir.ui.view">
        <field name="name">club.invoice.tree</field>
        <field name="model">club.invoice</field>
        <field name="arch" type="xml">
            <tree string="Club Invoices" decoration-info="state == 'draft'" decoration-warning="payment_state == 'partial'" decoration-success="payment_state == 'paid'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="invoice_type" widget="badge"
                       decoration-primary="invoice_type == 'membership'"
                       decoration-info="invoice_type == 'court_corporate'"
                       decoration-warning="invoice_type == 'shop'"
                       decoration-success="invoice_type == 'bar_event'"/>
                <field name="invoice_date"/>
                <field name="due_date"/>
                <field name="amount_untaxed" widget="monetary" sum="Total Untaxed"/>
                <field name="amount_tax" widget="monetary" sum="Total Tax"/>
                <field name="amount_total" widget="monetary" sum="Total Invoiced"/>
                <field name="amount_residual" widget="monetary" sum="Total Outstanding"/>
                <field name="payment_state" widget="badge"
                       decoration-danger="payment_state == 'not_paid'"
                       decoration-warning="payment_state == 'partial'"
                       decoration-success="payment_state == 'paid'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'posted'"
                       decoration-success="state == 'paid'"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- Invoice Form View -->
    <record id="view_club_invoice_form" model="ir.ui.view">
        <field name="name">club.invoice.form</field>
        <field name="model">club.invoice</field>
        <field name="arch" type="xml">
            <form string="Club Invoice">
                <header>
                    <button name="action_post" string="Post / Confirm Invoice" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel Invoice" type="object" invisible="state in ('cancelled', 'paid')"/>
                    <field name="payment_state" widget="statusbar" statusbar_visible="not_paid,partial,paid"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Customer / Corporate Invoice</span>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Client &amp; Category">
                            <field name="partner_id"/>
                            <field name="invoice_type"/>
                            <field name="member_id" invisible="not member_id"/>
                            <field name="booking_id" invisible="not booking_id"/>
                            <field name="shop_order_id" invisible="not shop_order_id"/>
                            <field name="bar_order_id" invisible="not bar_order_id"/>
                        </group>
                        <group string="Billing Dates">
                            <field name="invoice_date"/>
                            <field name="due_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Invoice Line Items" name="lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="tax_id"/>
                                    <field name="price_subtotal" widget="monetary" sum="Subtotal"/>
                                    <field name="price_tax" widget="monetary" sum="Tax"/>
                                    <field name="price_total" widget="monetary" sum="Total"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed" widget="monetary"/>
                                <field name="amount_tax" widget="monetary"/>
                                <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                    <label for="amount_total"/>
                                </div>
                                <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                                <field name="amount_paid" widget="monetary"/>
                                <field name="amount_residual" class="oe_subtotal_footer_separator" widget="monetary"/>
                            </group>
                        </page>

                        <page string="Registered Payments" name="payments" invisible="not payment_ids">
                            <field name="payment_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="payment_date"/>
                                    <field name="payment_method" widget="badge"/>
                                    <field name="transaction_ref"/>
                                    <field name="amount" widget="monetary" sum="Total Paid"/>
                                    <field name="state" widget="badge" decoration-success="state == 'posted'"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Terms &amp; Notes" name="notes">
                            <field name="notes" placeholder="Statutory payment terms, bank transfer IFSC details, UPI VPA identifier..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Invoice Action -->
    <record id="action_club_invoice" model="ir.actions.act_window">
        <field name="name">Invoices &amp; Billing</field>
        <field name="res_model">club.invoice</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create customer, membership, and corporate business invoices.
            </p>
        </field>
    </record>


    <!-- =========================================================================
         2. INBOUND PAYMENTS REGISTER (club.payment)
         ========================================================================= -->

    <record id="view_club_payment_tree" model="ir.ui.view">
        <field name="name">club.payment.tree</field>
        <field name="model">club.payment</field>
        <field name="arch" type="xml">
            <tree string="Payments Ledger" decoration-success="state == 'posted'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="payment_date"/>
                <field name="partner_id"/>
                <field name="source_type" widget="badge"
                       decoration-info="source_type == 'membership'"
                       decoration-primary="source_type == 'court'"
                       decoration-warning="source_type == 'shop'"
                       decoration-success="source_type == 'bar'"/>
                <field name="payment_method" widget="badge"
                       decoration-info="payment_method == 'upi'"
                       decoration-primary="payment_method == 'card'"
                       decoration-success="payment_method == 'cash'"/>
                <field name="transaction_ref"/>
                <field name="invoice_id"/>
                <field name="amount" widget="monetary" sum="Total Collections"/>
                <field name="state" widget="badge" decoration-success="state == 'posted'" decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_club_payment_form" model="ir.ui.view">
        <field name="name">club.payment.form</field>
        <field name="model">club.payment</field>
        <field name="arch" type="xml">
            <form string="Payment Record">
                <header>
                    <button name="action_post" string="Post Payment" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Void Payment" type="object" invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Payment Receipt</span>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Payment Details">
                            <field name="partner_id"/>
                            <field name="member_id" invisible="not member_id"/>
                            <field name="source_type"/>
                            <field name="amount" widget="monetary"/>
                        </group>
                        <group string="Transaction &amp; Method">
                            <field name="payment_date"/>
                            <field name="payment_method"/>
                            <field name="transaction_ref" placeholder="Bank UTR / Card Auth Code"/>
                            <field name="invoice_id"/>
                        </group>
                    </group>
                    <group string="Payment Memo">
                        <field name="notes" nolabel="1" placeholder="Cashier notes, bank settlement remarks..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_club_payment" model="ir.actions.act_window">
        <field name="name">Payments Register</field>
        <field name="res_model">club.payment</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- =========================================================================
         3. TAX CONFIGURATION (club.tax)
         ========================================================================= -->

    <record id="view_club_tax_tree" model="ir.ui.view">
        <field name="name">club.tax.tree</field>
        <field name="model">club.tax</field>
        <field name="arch" type="xml">
            <tree string="Tax Configurations">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="tax_type"/>
                <field name="amount"/>
                <field name="type_tax_use"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_club_tax_form" model="ir.ui.view">
        <field name="name">club.tax.form</field>
        <field name="model">club.tax</field>
        <field name="arch" type="xml">
            <form string="Tax Configuration">
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label">Tax Rule</span>
                        <h1><field name="name" placeholder="e.g. GST on Sports Facilities"/></h1>
                    </div>
                    <group>
                        <group string="Computation Method">
                            <field name="tax_type"/>
                            <field name="amount"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Scope &amp; Status">
                            <field name="type_tax_use"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Statutory Description">
                        <field name="description" nolabel="1" placeholder="Statutory references, HSN/SAC code notes..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_club_tax" model="ir.actions.act_window">
        <field name="name">Tax Configurations</field>
        <field name="res_model">club.tax</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
