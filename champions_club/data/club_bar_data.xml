<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequences -->
        <record id="seq_club_bar_order" model="ir.sequence">
            <field name="name">Champions Club Bar Order Sequence</field>
            <field name="code">club.bar.order</field>
            <field name="prefix">CC-BAR-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_club_bar_tab" model="ir.sequence">
            <field name="name">Champions Club Member Tab Sequence</field>
            <field name="code">club.bar.tab</field>
            <field name="prefix">CC-TAB-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Cafeteria & Bar Tables -->
        <record id="table_1" model="club.bar.table">
            <field name="name">Courtside Table 1</field>
            <field name="table_number">1</field>
            <field name="capacity">4</field>
            <field name="state">available</field>
        </record>

        <record id="table_2" model="club.bar.table">
            <field name="name">Courtside Table 2</field>
            <field name="table_number">2</field>
            <field name="capacity">4</field>
            <field name="state">available</field>
        </record>

        <record id="table_3" model="club.bar.table">
            <field name="name">Veranda Table 3</field>
            <field name="table_number">3</field>
            <field name="capacity">6</field>
            <field name="state">available</field>
        </record>

        <record id="table_4" model="club.bar.table">
            <field name="name">Lounge Booth 4</field>
            <field name="table_number">4</field>
            <field name="capacity">8</field>
            <field name="state">available</field>
        </record>

        <!-- DEMO DATA - Menu Items (Explicitly labeled DEMO DATA in compliance with DATA RULE) -->
        <record id="item_protein_shake" model="club.bar.item">
            <field name="name">[DEMO DATA] Post-Match Whey Protein Shake</field>
            <field name="category">nutrition</field>
            <field name="price">280.0</field>
        </record>

        <record id="item_club_sandwich" model="club.bar.item">
            <field name="name">[DEMO DATA] Triple-Decker Club Sandwich</field>
            <field name="category">food</field>
            <field name="price">320.0</field>
        </record>

        <record id="item_fresh_lime" model="club.bar.item">
            <field name="name">[DEMO DATA] Fresh Lime Mint Soda</field>
            <field name="category">beverage</field>
            <field name="price">120.0</field>
        </record>

        <record id="item_coconut_water" model="club.bar.item">
            <field name="name">[DEMO DATA] Chilled Tender Coconut Water</field>
            <field name="category">beverage</field>
            <field name="price">90.0</field>
        </record>

        <record id="item_artisan_coffee" model="club.bar.item">
            <field name="name">[DEMO DATA] Artisan Roast Cappuccino</field>
            <field name="category">beverage</field>
            <field name="price">180.0</field>
        </record>
    </data>
</odoo>
